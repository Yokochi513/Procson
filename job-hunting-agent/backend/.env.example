# このファイルを backend/.env にコピーして値を設定する。
# Gemini API キー（必須）: https://aistudio.google.com/apikey で取得。
# .env はリポジトリにコミットしない（NFR-3、.gitignore 済み）。
GEMINI_API_KEY=

# 以下は省略可（既定値は設計書 10章の前提値）
# PORT=3000
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_MS=30000
# MAX_MESSAGE_LEN=2000
# HISTORY_N=20
# DB_FILE=data/app.db
