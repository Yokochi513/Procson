//8.Result.component · TS
import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Router } from '@angular/router';
import { DiagnosisResult } from '../../services/diagnosis.service';

@Component({
  selector: 'app-result',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './result.component.html',
  styleUrls: ['./result.component.css']
})
export class ResultComponent implements OnInit {
  result: DiagnosisResult | null = null;

  constructor(private router: Router) {}

  ngOnInit() {
    const state = history.state as { result: DiagnosisResult };

    // 結果がなければ入力画面に戻す
    if (!state?.result) {
      this.router.navigate(['/']);
      return;
    }

    this.result = state.result;
  }

  // もう一度診断する
  onRetry() {
    this.router.navigate(['/']);
  }
}


//9.Result.component · HTML
<div class="page" *ngIf="result">
  <header class="header">
    <h1 class="title">あなたと岡山のつながり</h1>
    <p class="subtitle">診断結果</p>
  </header>

  <main class="result-container">

    <!-- 出力1: ストーリー -->
    <section class="card card--story">
      <div class="card-badge">出力 1</div>
      <h2 class="card-title">あなたの強み × 岡山の課題</h2>
      <p class="card-text">{{ result.story }}</p>
    </section>

    <!-- 出力2: ありえる未来 -->
    <section class="card card--future">
      <div class="card-badge">出力 2</div>
      <h2 class="card-title">岡山での「ありえる未来」</h2>
      <p class="card-text">{{ result.future }}</p>
    </section>

    <!-- 出力3: 今すぐできること -->
    <section class="card card--actions">
      <div class="card-badge">出力 3</div>
      <h2 class="card-title">今すぐできる岡山との関わり方</h2>
      <p class="card-text">{{ result.actions }}</p>
    </section>

    <button class="retry-btn" (click)="onRetry()">
      もう一度診断する
    </button>
  </main>
</div>


