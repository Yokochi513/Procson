//5.Loading.component · TS
import { Component, OnInit } from '@angular/core';
import { Router } from '@angular/router';
import { DiagnosisService, UserInput } from '../../services/diagnosis.service';

@Component({
  selector: 'app-loading',
  standalone: true,
  templateUrl: './loading.component.html',
  styleUrls: ['./loading.component.css']
})
export class LoadingComponent implements OnInit {

  constructor(
    private router: Router,
    private diagnosisService: DiagnosisService
  ) {}

  ngOnInit() {
    // 入力画面から渡されたデータを受け取る
    const state = history.state as { input: UserInput };

    // データがなければ入力画面に戻す
    if (!state?.input) {
      this.router.navigate(['/']);
      return;
    }

    this.runDiagnosis(state.input);
  }

  private async runDiagnosis(input: UserInput) {
    try {
      const result = await this.diagnosisService.diagnose(input);
      // 結果画面へ遷移。診断結果をstateで渡す
      this.router.navigate(['/result'], { state: { result } });
    } catch (error) {
      console.error('診断エラー:', error);
      // エラー時は入力画面に戻す
      this.router.navigate(['/'], { state: { error: true } });
    }
  }
}

