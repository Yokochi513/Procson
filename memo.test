//1.Diagnosis.service · TS
import { Injectable } from '@angular/core';

export interface UserInput {
  hobby: string;             // 1. 趣味・好きなこと（必須）
  worry: string;             // 2. 今困っていること・悩み（必須）
  effort: string;            // 3. 大学入学後に最も力を入れたこと（必須）
  diagnosticResult: string;  // 4. 就活アプリの診断結果（必須）
  dream?: string;            // 5. 将来の夢・やりたい仕事（任意）
  location?: string;         // 6. 出身地・住んでいる場所（任意）
}

export interface DiagnosisResult {
  story: string;    // 出力1: あなたの強み×岡山の課題 ストーリー
  future: string;   // 出力2: 岡山での「ありえる未来」
  actions: string;  // 出力3: 今すぐできる岡山との関わり方
}

@Injectable({
  providedIn: 'root'
})
export class DiagnosisService {

  private buildPrompt(input: UserInput): string {
    const optionalDream = input.dream
      ? `・将来の夢・やりたい仕事：${input.dream}`
      : '';
    const optionalLocation = input.location
      ? `・出身地・住んでいる場所：${input.location}`
      : '';

    return `あなたは岡山の地域と若者をつなぐ、温かく情熱的なナビゲーターです。
以下のユーザー情報をもとに、岡山でいきる（生きる・活きる）自分をイメージできる診断結果を生成してください。

【ユーザー情報】
・趣味・好きなこと：${input.hobby}
・今困っていること・悩み：${input.worry}
・大学入学後に最も力を入れたこと：${input.effort}
・就活アプリの診断結果：${input.diagnosticResult}
${optionalDream}
${optionalLocation}

【出力形式】
必ず以下のJSONのみを返してください。前置きや説明文は一切不要です。

{
  "story": "【出力1】悩みや強みと岡山の地域課題を結びつけた物語文章を300〜400字で。なぜ岡山でその強みが活きるかを具体的に語り、二人称（あなた）で語りかけるスタイルで。",
  "future": "【出力2】5〜10年後、このユーザーが岡山でどう生きているかを物語風に300〜400字で。強みや趣味が岡山でどう花開いているか具体的なシーンで描写。",
  "actions": "【出力3】ユーザーの興味・強みに合った岡山で今すぐできる関わり方を3つ。①②③の形式で、各100字程度で具体的に。"
}`;
  }

  async diagnose(input: UserInput): Promise<DiagnosisResult> {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1000,
        messages: [{ role: 'user', content: this.buildPrompt(input) }]
      })
    });

    if (!response.ok) {
      throw new Error(`APIエラー: ${response.status}`);
    }

    const data = await response.json();
    const text = data.content
      .map((item: any) => item.type === 'text' ? item.text : '')
      .join('');

    const clean = text.replace(/```json|```/g, '').trim();
    const parsed = JSON.parse(clean);

    return {
      story: parsed.story,
      future: parsed.future,
      actions: parsed.actions,
    };
  }
}

//2.Input.component · TS
import { Component } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Router } from '@angular/router';
import { UserInput } from '../../services/diagnosis.service';

@Component({
  selector: 'app-input',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './input.component.html',
  styleUrls: ['./input.component.css']
})
export class InputComponent {
  formData: UserInput = {
    hobby: '',
    worry: '',
    effort: '',
    diagnosticResult: '',
    dream: '',
    location: '',
  };

  // 必須項目が全部入力されているか確認
  get isValid(): boolean {
    return (
      this.formData.hobby.trim() !== '' &&
      this.formData.worry.trim() !== '' &&
      this.formData.effort.trim() !== '' &&
      this.formData.diagnosticResult.trim() !== ''
    );
  }

  constructor(private router: Router) {}

  onSubmit() {
    if (!this.isValid) return;
    // ローディング画面へ遷移。入力データをstateで渡す
    this.router.navigate(['/loading'], {
      state: { input: this.formData }
    });
  }
}

//3.Input.component · HTML
<div class="page">
  <header class="header">
    <h1 class="title">「岡山でいきる自分」診断</h1>
    <p class="subtitle">あなたと岡山のつながりを発見する</p>
  </header>

  <main class="form-container">
    <!-- 必須項目 -->
    <section class="section">
      <h2 class="section-title">あなたのことを教えてください</h2>
      <p class="section-note">※のついた項目は必須です</p>

      <div class="field">
        <label class="label" for="hobby">
          趣味・好きなこと <span class="required">※</span>
        </label>
        <p class="hint">例：音楽を聴くこと / カフェ巡り / バスケットボール</p>
        <textarea
          id="hobby"
          class="textarea"
          [(ngModel)]="formData.hobby"
          placeholder="自由に入力してください"
          rows="3"
        ></textarea>
      </div>

      <div class="field">
        <label class="label" for="worry">
          今困っていること・悩み <span class="required">※</span>
        </label>
        <p class="hint">例：将来やりたいことが見つからない / 地元に帰るか迷っている / 自分の強みがわからない</p>
        <textarea
          id="worry"
          class="textarea"
          [(ngModel)]="formData.worry"
          placeholder="自由に入力してください"
          rows="3"
        ></textarea>
      </div>

      <div class="field">
        <label class="label" for="effort">
          大学入学後に最も力を入れたこと <span class="required">※</span>
        </label>
        <p class="hint">きっかけ・何を考えたか・どう行動したかも含めて書いてみてください</p>
        <textarea
          id="effort"
          class="textarea"
          [(ngModel)]="formData.effort"
          placeholder="自由に入力してください"
          rows="5"
        ></textarea>
      </div>

      <div class="field">
        <label class="label" for="diagnosticResult">
          就活アプリの診断結果 <span class="required">※</span>
        </label>
        <p class="hint">診断結果のテキストをそのままコピー＆ペーストしてください</p>
        <textarea
          id="diagnosticResult"
          class="textarea"
          [(ngModel)]="formData.diagnosticResult"
          placeholder="診断結果をここに貼り付けてください"
          rows="5"
        ></textarea>
      </div>
    </section>

    <!-- 任意項目 -->
    <section class="section optional-section">
      <h2 class="section-title">任意項目（入力するとより詳しい診断ができます）</h2>

      <div class="field">
        <label class="label" for="dream">将来の夢・やりたい仕事</label>
        <p class="hint">入力すると夢と岡山のつながりをより具体的に描けます</p>
        <textarea
          id="dream"
          class="textarea"
          [(ngModel)]="formData.dream"
          placeholder="自由に入力してください"
          rows="3"
        ></textarea>
      </div>

      <div class="field">
        <label class="label" for="location">出身地・住んでいる場所</label>
        <p class="hint">入力すると地域性を考慮した提案が可能になります</p>
        <input
          id="location"
          class="input"
          type="text"
          [(ngModel)]="formData.location"
          placeholder="例：岡山市北区、倉敷市など"
        />
      </div>
    </section>

    <button
      class="submit-btn"
      [disabled]="!isValid"
      (click)="onSubmit()"
    >
      診断する →
    </button>

    <p *ngIf="!isValid" class="validation-msg">
      ※のついた項目をすべて入力してください
    </p>
  </main>
</div>

